# ============================================
# Kaggle API Credentials
# ============================================
#Mude para as suas credenciais do Kaggle no arquivo .env (não compartilhe este arquivo publicamente)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================
# Dataset
# ============================================
DATASET=tunguz/bank-marketing-data-set

# ============================================
# Data Paths
# ============================================
DEFAULT_BANK_PATH=data/kaggle/processed
DEFAULT_CATALOG_PATH=data/kaggle/synthetic_enrichment/offer_catalog.json
OUT_DIR=data/experiments/etapa3

# ============================================
# Simulation Parameters
# ============================================
SEED=42
BASE_DATE=2026-06-01
DELAY_SCALE_DAYS=2.0

# ============================================
# Bandit Policy Parameters
# ============================================
# Thompson Sampling
THOMPSON_ALPHA0=1.0
THOMPSON_BETA0=1.0

# UCB1
UCB1_EXPLORATION_BONUS=2.0

# Baseline
BASELINE_PREFERRED_ARM=0
