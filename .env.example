# ============================================
# Kaggle API Credentials
# ============================================
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================
# Datasets
# ============================================
DATASET1=aguado/telemarketing-jyb-dataset
DATASET2=tunguz/bank-marketing-data-set
DATASET3=henriqueyamahata/bank-marketing
DATASET4=dharmik34/bank-term-deposit-subscription

# ============================================
# Data Paths
# ============================================
DEFAULT_BANK_PATH=data/kaggle/processed/clean_bank.parquet
DEFAULT_CATALOG_PATH=data/kaggle/synthetic_enrichment/offer_catalog.json
OUT_DIR=data/experiments/etapa3

# ============================================
# Simulation Parameters
# ============================================
SEED=42
BASE_DATE=2026-06-01
DELAY_SCALE_DAYS=2.0

# ============================================
# Bandit Policy Parameters
# ============================================
THOMPSON_ALPHA0=1.0
THOMPSON_BETA0=1.0
UCB1_EXPLORATION_BONUS=2.0
BASELINE_PREFERRED_ARM=0

# ============================================
# Assistente LLM + RAG
# ============================================
ASSISTANT_PROVIDER=offline
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_TOP_K=3
ASSISTANT_POLICY_VERSION=assistant-0.1.0

# Azure OpenAI (alvo de produção — Etapa 6)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Alternativas
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
